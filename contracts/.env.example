# Local secrets. Ignored by git (.gitignore covers .env). Do not commit.

# Deployer key. Required for any non-local network.
#   npx hardhat run scripts/newDeployer.ts   generates a fresh one
PRIVATE_KEY=

# Treasury receiving the performance fee. Defaults to the deployer.
FEE_RECIPIENT=

# --- BOT Chain endpoints -----------------------------------------------------
# Verified against https://dev-docs.botchain.ai/docs/Developers/json-rpc-endpoint/
# Mainnet: chain 677 on botchain.ai. Testnet: chain 968 on bohr.life.
BOT_MAINNET_RPC=https://rpc.botchain.ai
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_EXPLORER=https://scan.bohr.life
BOT_TESTNET_EXPLORER_API=https://scan.bohr.life/api
BOT_MAINNET_EXPLORER_API=https://scan.botchain.ai/api

# BOT Chain's explorer is Blockscout-flavoured and accepts any non-empty key.
EXPLORER_API_KEY=empty

# --- Real protocol addresses --------------------------------------------------
# All of these have working defaults per network in scripts/config.ts; set them only to
# override. There is no mock mode to fall back on, so a wrong value here fails preflight
# rather than quietly deploying against something that does not exist.
#
#   ASSET_ADDRESS    the chain's USDT. Leave blank for the per-network default.
#   ASSET_DECIMALS   USDT is 6 dp on both networks. Preflight refuses to deploy if the
#                    token disagrees with this, because every amount would be wrong.
#   BDEX_V2_ROUTER   BDEX V2 Router02. The pair is resolved through its factory.
#   PAIRED_TOKEN     other side of the LP leg; defaults to WBOT.
ASSET_ADDRESS=
ASSET_DECIMALS=6
BDEX_V2_ROUTER=
PAIRED_TOKEN=

# Per-strategy cap and vault TVL ceiling, in whole USDT. Sized against pool depth: the
# testnet USDT/WBOT pair holds ~6.5k, so a position of a few hundred keeps our own price
# impact small at both entry and exit.
LEG_CAP=500
DEPOSIT_CAP=1000

# --- e2e ---------------------------------------------------------------------
# The runner needs real USDT and there is no faucet for it, so e2e buys some by swapping
# native BOT through BDEX.
E2E_AMOUNT=20
E2E_BOT_SPEND=1

# --- HarvestBot keeper -------------------------------------------------------
HARVEST_INTERVAL_SEC=300
HARVEST_MIN_YIELD_MULTIPLE=5
HARVEST_MAX_IDLE_HOURS=24
HARVEST_ONCE=false

# --- tests -------------------------------------------------------------------
# The suite runs against a fork of testnet so it exercises the real BDEX. Pin a block for
# reproducible reserves; NO_FORK=true skips forking entirely.
FORK_BLOCK=
NO_FORK=false

REPORT_GAS=false
