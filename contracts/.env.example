# Deployer key. Required for any non-local network. Never commit the real .env.
PRIVATE_KEY=

# Treasury receiving the performance fee. Defaults to the deployer.
FEE_RECIPIENT=

# --- BOT Chain endpoints -----------------------------------------------------
# Official values: https://dev-docs.botchain.ai/docs/Developers/json-rpc-endpoint/
# Mainnet is chain 677 on botchain.ai; testnet is chain 968 and lives on bohr.life.
BOT_MAINNET_RPC=https://rpc.botchain.ai
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_EXPLORER=https://scan.bohr.life
BOT_TESTNET_EXPLORER_API=https://scan.bohr.life/api
BOT_MAINNET_EXPLORER_API=https://scan.botchain.ai/api

# BOT Chain's explorer is Blockscout-flavoured and accepts any non-empty key.
EXPLORER_API_KEY=empty

# --- Mainnet: real protocol addresses ----------------------------------------
# Required before deploy:mainnet. The script refuses to deploy mocks to mainnet unless
# MAINNET_USE_MOCKS is set to true, so a testnet shortcut cannot reach production.
ASSET_ADDRESS=
ASSET_DECIMALS=18
TBILL_YIELD_SOURCE=
CREDIT_POOL=
LIQUIDITY_POOL=
PAIR_ADDRESS=
DEPOSIT_CAP=1000000
MAINNET_USE_MOCKS=false

# --- HarvestBot keeper -------------------------------------------------------
HARVEST_INTERVAL_SEC=300
HARVEST_MIN_YIELD_MULTIPLE=5
HARVEST_MAX_IDLE_HOURS=24
HARVEST_ONCE=false

REPORT_GAS=false
