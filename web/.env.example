# Chain the app targets when no wallet is connected.
# 968 = BOT Chain Testnet, 677 = BOT Chain Mainnet, 31337 = local Hardhat node.
# Flipping the frontend to mainnet is this one variable.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=968

# RPC overrides. Both default to the published BOT Chain endpoints; the testnet is on
# bohr.life, not a botchain.ai subdomain.
# https://dev-docs.botchain.ai/docs/Developers/json-rpc-endpoint/
NEXT_PUBLIC_BOT_MAINNET_RPC=https://rpc.botchain.ai
NEXT_PUBLIC_BOT_TESTNET_RPC=https://rpc.bohr.life
NEXT_PUBLIC_BOT_TESTNET_CHAIN_ID=968
NEXT_PUBLIC_BOT_TESTNET_EXPLORER=https://scan.bohr.life

# Optional. Without it, injected wallets (MetaMask, Rabby, Brave) still connect and the
# app is fully usable; only the WalletConnect QR and mobile deep-link flows are absent,
# and the wallet list hides them rather than offering a flow that would fail.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# How far back the portfolio page scans for vault events. Public RPCs often cap
# eth_getLogs ranges; lower this if history requests are rejected.
NEXT_PUBLIC_LOG_LOOKBACK_BLOCKS=100000
